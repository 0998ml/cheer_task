<div class="login-bg"></div>
<div class="d-flex justify-content-center align-items-center login-container py-5">
  <div class="glass-card p-5 shadow-lg rounded-4 w-100" style="max-width: 450px;">
    <div class="text-center mb-4">
      <div class="login-icon mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="bi bi-person-plus-fill text-primary" viewBox="0 0 16 16">
          <path d="M1 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1H1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/>
          <path fill-rule="evenodd" d="M13.5 5a.5.5 0 0 1 .5.5V7h1.5a.5.5 0 0 1 0 1H14v1.5a.5.5 0 0 1-1 0V8h-1.5a.5.5 0 0 1 0-1H13V5.5a.5.5 0 0 1 .5-.5z"/>
        </svg>
      </div>
      <h2 class="fw-bold login-title">Sign Up</h2>
      <p class="text-muted small">新しくアカウントを作成しましょう</p>
    </div>

    <%= form_with model: @user, url: '/users', local: true, class: "needs-validation" do |f| %>

      <% if @user.errors.any? %>
        <div class="alert alert-danger" role="alert" style="background-color: rgba(248, 215, 218, 0.9); border: none;">
          <h6 class="alert-heading fw-bold"><%= @user.errors.count %>件のエラーがあります:</h6>
          <ul class="mb-0 small text-start">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-floating mb-3">
        <%= f.text_field :name, class: "form-control custom-input", id: "floatingName", placeholder: "Your Name", required: true %>
        <%= f.label :name, "名前", for: "floatingName" %>
      </div>

      <div class="form-floating mb-3">
        <%= f.email_field :email, class: "form-control custom-input", id: "floatingEmail", placeholder: "name@example.com", required: true %>
        <%= f.label :email, "メールアドレス", for: "floatingEmail" %>
      </div>

      <div class="form-floating mb-3">
        <%= f.password_field :password, class: "form-control custom-input", id: "floatingPassword", placeholder: "Password", required: true %>
        <%= f.label :password, "パスワード", for: "floatingPassword" %>
      </div>

      <div class="form-floating mb-4">
        <%= f.password_field :password_confirmation, class: "form-control custom-input", id: "floatingPasswordConfirm", placeholder: "Confirm Password", required: true %>
        <%= f.label :password_confirmation, "パスワード（確認用）", for: "floatingPasswordConfirm" %>
      </div>

      <div class="d-grid gap-2 mt-4">
        <%= f.submit "登録する", class: "btn btn-premium btn-lg rounded-pill fw-bold shadow-sm" %>
      </div>
    <% end %>

    <div class="text-center mt-4">
      <p class="text-muted small mb-0">すでにアカウントをお持ちですか？</p>
      <%= link_to "ログインはこちら", login_path, class: "text-decoration-none fw-bold premium-link mt-1 d-inline-block" %>
    </div>
  </div>
</div>
